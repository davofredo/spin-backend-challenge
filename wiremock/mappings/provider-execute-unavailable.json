{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/provider/v1/execute",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.accountId == 'acc-provider-down')]"
      }
    ]
  },
  "response": {
    "status": 503,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "UNAVAILABLE",
      "message": "Provider is temporarily unavailable"
    }
  }
}
